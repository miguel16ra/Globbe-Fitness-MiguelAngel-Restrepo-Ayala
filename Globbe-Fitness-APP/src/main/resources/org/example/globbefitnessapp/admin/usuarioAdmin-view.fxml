<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="676.0" prefWidth="1051.0" styleClass="admin-root" stylesheets="@../css/globbe-admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.globbefitnessapp.controller.admin.UsuariosController">

    <top>
        <VBox spacing="10" styleClass="header-box">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>

            <Label styleClass="screen-title" text="Globbe Fitness Center">
            <padding>
               <Insets top="3.0" />
            </padding></Label>

            <Label styleClass="screen-subtitle" text="Gestión de Usuarios">
                <VBox.margin>
                    <Insets left="3.0" top="-10.0" />
                </VBox.margin>
            <padding>
               <Insets top="-3.0" />
            </padding>
            </Label>

            <HBox spacing="10">
                <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por nombre, apellido o correo" styleClass="globbe-input" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaUsuarios" prefHeight="331.0" prefWidth="732.0" styleClass="globbe-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="120" text="Nombre" />
                <TableColumn fx:id="colApellidos" prefWidth="150" text="Apellidos" />
                <TableColumn fx:id="colCorreo" prefWidth="180.0" text="Correo" />
                <TableColumn fx:id="colPassword" prefWidth="120.0" text="Password" />
                <TableColumn fx:id="colRol" prefWidth="100.0" text="Rol" />
            </columns>
        </TableView>
    </center>

    <right>
        <VBox prefWidth="280" spacing="10" styleClass="panel-card">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label styleClass="card-title" text="Editar usuario">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Label>

            <TextField fx:id="txtNombre" promptText="Nombre" styleClass="globbe-input" />
            <TextField fx:id="txtApellidos" promptText="Apellidos" styleClass="globbe-input" />
            <TextField fx:id="txtCorreo" promptText="Correo" styleClass="globbe-input" />
            <TextField fx:id="txtPassword" promptText="Password" styleClass="globbe-input" />
            <ComboBox fx:id="comboRol" prefWidth="250" promptText="Seleccionar rol" styleClass="globbe-combo" />

            <Button fx:id="btnActualizar" maxWidth="Infinity" styleClass="globbe-button" text="Actualizar" />
            <Button fx:id="btnEliminar" maxWidth="Infinity" styleClass="globbe-button-secondary" text="Eliminar" />
            <Button fx:id="btnLimpiar" maxWidth="Infinity" styleClass="globbe-button-secondary" text="Limpiar" />
            <Button fx:id="btnVolver" maxWidth="Infinity" styleClass="globbe-button-secondary" text="Volver" />
         <BorderPane.margin>
            <Insets left="7.0" />
         </BorderPane.margin>
        </VBox>
    </right>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
</BorderPane>
