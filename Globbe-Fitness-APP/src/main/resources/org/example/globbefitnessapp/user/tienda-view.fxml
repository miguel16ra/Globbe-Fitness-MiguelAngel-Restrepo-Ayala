<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="820.0" prefWidth="1350.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.globbefitnessapp.controller.user.TiendaController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <Label text="Globbe Fitness Center"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;" />

            <Label text="Tienda"
                   style="-fx-font-size: 14px;" />
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Productos"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colNombreProducto" prefWidth="140.0" text="Nombre" />
                            <TableColumn fx:id="colDescripcionProducto" prefWidth="240.0" text="Descripción" />
                            <TableColumn fx:id="colPrecioProducto" prefWidth="90.0" text="Precio" />
                            <TableColumn fx:id="colStockProducto" prefWidth="80.0" text="Stock" />
                            <TableColumn fx:id="colActivoProducto" prefWidth="80.0" text="Activo" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <padding>
                        <Insets top="40.0" right="5.0" bottom="5.0" left="5.0"/>
                    </padding>

                    <Button fx:id="btnAnadir"
                            mnemonicParsing="false"
                            prefWidth="150.0"
                            prefHeight="35.0"
                            text="Añadir" />

                    <Button fx:id="btnQuitar"
                            mnemonicParsing="false"
                            prefWidth="150.0"
                            prefHeight="35.0"
                            text="Quitar" />
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Carrito"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <TableView fx:id="tablaCarrito" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colNombreCarrito" prefWidth="170.0" text="Nombre" />
                            <TableColumn fx:id="colPrecioCarrito" prefWidth="90.0" text="Precio" />
                            <TableColumn fx:id="colCantidadCarrito" prefWidth="90.0" text="Cantidad" />
                            <TableColumn fx:id="colSubtotalCarrito" prefWidth="110.0" text="Subtotal" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <Separator />

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Label text="Método de pago:"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;" />

                <ComboBox fx:id="cbMetodoPago" prefWidth="160.0" promptText="Seleccione método" />

                <Label text="Total:"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;" />

                <Label fx:id="lblTotal"
                       text="0.00 €"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: green;" />

                <Button fx:id="btnFinalizarCompra"
                        mnemonicParsing="false"
                        prefWidth="180.0"
                        prefHeight="35.0"
                        text="Finalizar compra" />

                <Button fx:id="btnVolver"
                        mnemonicParsing="false"
                        prefWidth="120.0"
                        prefHeight="35.0"
                        text="Volver" />
            </HBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label text="Compras"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombreCompra" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="colTotalCompra" prefWidth="120.0" text="Total" />
                        <TableColumn fx:id="colFechaCompra" prefWidth="180.0" text="Fecha de venta" />
                        <TableColumn fx:id="colMetodoPagoCompra" prefWidth="140.0" text="Método de pago" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>